{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx src/index.ts",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "start:prod": "npm run push --workspace=@workspace/db && node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@workspace/api-zod": "*",
    "@workspace/db": "*",
    "@workspace/integrations-gemini-ai": "*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "^0.45.2",
    "express": "^5",
    "jsonwebtoken": "^9.0.3",
    "openai": "^6.33.0",
    "pino": "^9",
    "pino-http": "^10",
    "satori": "^0.26.0",
    "zod": "^3.25.76",
    "@workspace/draft-core": "*"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.3",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0",
    "tsx": "^4.21.0",
    "vite": "7.3.5"
  }
}

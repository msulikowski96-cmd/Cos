# Skopiuj do .env (plik .env jest ignorowany przez git) albo ustaw w panelu hostingu.

# Klucz z https://developer.riotgames.com — klucz deweloperski wygasa po 24 h.
RIOT_API_KEY=

# Model AI — dowolne API zgodne z OpenAI. Domyślnie NVIDIA (jak w Nexus Sight).
NVIDIA_API_KEY=
NVIDIA_AI_MODEL=qwen/qwen3-next-80b-a3b-instruct
# Inny dostawca? Ustaw AI_API_KEY, AI_BASE_URL i AI_MODEL, np. OpenAI:
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

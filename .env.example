# Skopiuj do .env (plik .env jest ignorowany przez git) albo ustaw w panelu hostingu.

# PostgreSQL (np. Neon albo Render). Bez tego konta zapisują się w pliku .local/db.json (tylko do developmentu).
DATABASE_URL=
# Losowy ciąg, min. 16 znaków — podpisuje sesje logowania.
SESSION_SECRET=
# Opcjonalnie: hasło admina (min. 12 znaków) dla pierwszego adresu z ADMIN_EMAILS.
ADMIN_PASSWORD=
ADMIN_EMAILS=msulikowski96@gmail.com,sulikowskim96@gmail.com

# Klucz z https://developer.riotgames.com — klucz deweloperski wygasa po 24 h.
RIOT_API_KEY=

# Model AI (NVIDIA, API zgodne z OpenAI).
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_FAST_MODEL=openai/gpt-oss-20b

# Opcjonalnie: token nakładki desktopowej (min. 24 znaki).
OVERLAY_TOKEN=

{
  "name": "nexus-draft",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "lib/integrations/*",
    "scripts"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build --config artifacts/web/vite.config.ts && node scripts/build-server.mjs",
    "start": "NODE_ENV=production node --enable-source-maps dist/server.mjs",
    "lint": "tsc --build --noEmit",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:firestore": "firebase deploy --only firestore:rules",
    "deploy:firebase": "npm run build && firebase deploy",
    "test": "vitest run",
    "sync:champions": "node scripts/sync-champions.mjs"
  },
  "private": true,
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@workspace/api-client-react": "*",
    "@workspace/api-server": "*",
    "@workspace/api-zod": "*",
    "@workspace/db": "*",
    "@workspace/integrations-gemini-ai": "*",
    "@workspace/web": "*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "express": "^5.0.1",
    "firebase": "^12.19.0",
    "jsonwebtoken": "^9.0.3",
    "openai": "^6.33.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "satori": "^0.26.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "firebase-tools": "^15.30.2",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "vite": "^7.3.5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "path-to-regexp": "8.4.0",
    "protobufjs": "7.6.5",
    "drizzle-orm": "^0.45.2",
    "lodash": "^4.18.0"
  }
}
